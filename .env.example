# Copy this file to .env and fill in your values.

# --- Google (required for real measurements; leave blank for demo mode) ---
# One server-side key with these APIs enabled: Solar API, Geocoding API, Maps Static API
GOOGLE_API_KEY=
# Optional: restrict geocoding to one country, e.g. US
GEOCODE_COUNTRY=US

# --- Admin page (/admin) ---
ADMIN_PASSWORD=change-me

# --- CRM: comma-separated list of any of: webhook, gohighlevel, hubspot, jobnimbus ---
CRM_PROVIDERS=webhook

# Generic webhook (Zapier "Catch Hook", Make, n8n, or any CRM's inbound webhook)
WEBHOOK_URL=
WEBHOOK_SECRET=

# GoHighLevel (Settings → Private Integrations → token with contacts + opportunities scopes)
GHL_TOKEN=
GHL_LOCATION_ID=
GHL_PIPELINE_ID=
GHL_STAGE_ID=
GHL_TAGS=online-estimate

# HubSpot (Settings → Integrations → Private Apps; scopes: crm.objects.contacts.read/write)
HUBSPOT_TOKEN=

# JobNimbus (Settings → API → new key). Names must match your workflow exactly.
JOBNIMBUS_API_KEY=
JOBNIMBUS_RECORD_TYPE=Customer
JOBNIMBUS_STATUS=Lead
JOBNIMBUS_SOURCE=Website

PORT=3000
# MOCK_SOLAR=1   # force demo mode even with a key
